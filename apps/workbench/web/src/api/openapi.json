  "info": {
    "title": "Janus workbench",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/documents": {
      "get": {
        "description": "Every document with its status. The client polls this while any is being read.",
        "operationId": "list_documents",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentRow"
                  },
                  "title": "Response List Documents",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Documents"
      },
      "post": {
        "description": "Take a PDF as the request body and queue it for reading.\n\nA file that is not a readable PDF is kept too: its row says why it failed.",
        "operationId": "add_document",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "default": "document.pdf",
              "maxLength": 300,
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/pdf": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentRow"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "The file is larger than the limit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Document"
      }
    },
    "/api/documents/{document}": {
      "delete": {
        "operationId": "delete_document",
        "parameters": [
          {
            "description": "SHA-256 of the PDF",
            "in": "path",
            "name": "document",
            "required": true,
            "schema": {
              "description": "SHA-256 of the PDF",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Document",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Document"
      }
    },
    "/api/documents/{document}/extract": {
      "post": {
        "description": "Run a spec, given as text, against the document.",
        "operationId": "extract_document",
        "parameters": [
          {
            "description": "SHA-256 of the PDF",
            "in": "path",
            "name": "document",
            "required": true,
            "schema": {
              "description": "SHA-256 of the PDF",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Document",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extract Document"
      }
    },
    "/api/documents/{document}/inspect": {
      "get": {
        "description": "Pages, tables with their first rows, headings, and where `find` is printed.",
        "operationId": "inspect_document",
        "parameters": [
          {
            "description": "SHA-256 of the PDF",
            "in": "path",
            "name": "document",
            "required": true,
            "schema": {
              "description": "SHA-256 of the PDF",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Document",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "find",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Find"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inspection"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inspect Document"
      }
    },
    "/api/documents/{document}/pages/{page}": {
      "get": {
        "operationId": "page_layout",
        "parameters": [
          {
            "description": "SHA-256 of the PDF",
            "in": "path",
            "name": "document",
            "required": true,
            "schema": {
              "description": "SHA-256 of the PDF",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Document",
              "type": "string"
            }
          },
          {
            "in": "path",
